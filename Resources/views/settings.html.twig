{% extends 'base.html.twig' %}
{% block page_title %}{{ 'kanka_mail.title'|trans }}{% endblock %}
{% block page_content_start %}
{% for message in app.flashes('kanka_mail_saved') %}
<div class="alert alert-success" role="status">{{ message }}</div>
{% endfor %}
{{ parent() }}
{% endblock %}
{% block main %}
{{ form_start(form) }}
{{ form_errors(form) }}
<div class="card mb-3"><div class="card-body">
    <p>{{ 'kanka_mail.settings_intro'|trans }}</p>
    {{ form_row(form.sender_name) }}{{ form_row(form.enabled) }}{{ form_row(form.mark_pending) }}

</div></div>
<div class="alert alert-info">{{ 'kanka_mail.languages_help'|trans }}</div>
<div class="card mb-3"><div class="card-body">
    <h2 class="card-title">{{ 'kanka_mail.placeholders'|trans }}</h2>
    {% include '@KankaInvoiceMail/placeholders.html.twig' %}
</div></div>
{% for section in sections %}
<div class="card mb-3"><div class="card-body">
    <h2 class="card-title">{{ section.language|language_name }} ({{ section.language }}) · {{ 'kanka_mail.customer_count'|trans({'%count%': section.count}) }}</h2>
    {% if section.count == 0 %}<p class="text-secondary">{{ 'kanka_mail.unused'|trans }}</p>{% endif %}
    {% if section.missing %}<p class="text-danger">{{ 'kanka_mail.missing_template'|trans }}</p>{% endif %}
    {{ form_widget(attribute(form, 'template_' ~ section.language)) }}

</div></div>
{% else %}<p>{{ 'kanka_mail.no_customers'|trans }}</p>{% endfor %}
<button class="btn btn-primary mb-3" type="submit">{{ 'kanka_mail.save'|trans }}</button>
{{ form_end(form) }}
<p><a href="{{ path('kanka_invoice_mail_maintenance') }}">{{ 'kanka_mail.maintenance'|trans }}</a></p>
<p class="text-secondary">{{ 'kanka_mail.developer'|trans }} <a href="https://kanka.dev" rel="noopener">kanka.dev</a> · <a href="https://github.com/kankadev/kimai-invoice-mail">{{ 'kanka_mail.documentation'|trans }}</a></p>
{% endblock %}
