{% extends 'base.html.twig' %}
{% block page_title %}{{ 'kanka_mail.prepare'|trans }}{% endblock %}
{% block main %}
<div class="card"><div class="card-body">
    <p>{{ 'kanka_mail.invoice'|trans }}: <strong>{{ invoice.invoiceNumber }}</strong> · {{ language|language_name }}</p>
    <p>{{ 'kanka_mail.from'|trans }}: {{ sender }}</p>
    <p>{{ 'kanka_mail.attachment'|trans }}: <a href="{{ path('admin_invoice_download', {id: invoice.id}) }}" target="_blank" rel="noopener">{{ invoice.invoiceFilename }}</a></p>
    {{ form_start(form) }}{{ form_widget(form) }}
    <button class="btn btn-primary" type="submit">{{ 'kanka_mail.preview'|trans }}</button>{{ form_end(form) }}
</div></div>
{% endblock %}
